{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClosedLoopVerificationSpec",
  "description": "Deterministic Physical Verification Schema for CAD vs Machined workpiece",
  "type": "object",
  "required": ["verification_status", "volumetric_fidelity_pct", "target_removed_vol_mm3", "material_removed_mm3", "gouge_detected", "uncut_detected"],
  "properties": {
    "strategy_name": { "type": "string" },
    "verification_status": { "type": "string", "enum": ["PASS", "FAIL_GOUGE", "FAIL_UNCUT"] },
    "volumetric_fidelity_pct": { "type": "number" },
    "target_removed_vol_mm3": { "type": "number" },
    "material_removed_mm3": { "type": "number" },
    "uncut_material_mm3": { "type": "number" },
    "gouge_detected": { "type": "boolean" },
    "uncut_detected": { "type": "boolean" },
    "surface_deviation": {
      "type": "object",
      "properties": {
        "floor_scallop_height_um": { "type": "number" },
        "mean_surface_deviation_um": { "type": "number" },
        "max_surface_deviation_um": { "type": "number" }
      }
    },
    "verification_details": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
